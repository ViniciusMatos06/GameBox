# Database (defaults already match docker-compose.yml, override only if needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamebox
DB_USER=gamebox
DB_PASSWORD=gamebox

# JWT (generate any long random string for local dev, use a real secret in production)
JWT_SECRET=change-this-dev-only-secret-change-this-dev-only-secret
JWT_EXPIRATION_MINUTES=10080

# Frontend origin allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# RAWG API key (get one at https://rawg.io/apidocs) - now lives only on the backend
RAWG_API_KEY=

SERVER_PORT=8080
