# Copy this file to .env (same folder as docker-compose.yml) and fill in
# RAWG_API_KEY. docker compose reads .env automatically - no need to export
# anything by hand.

# Get a free key at https://rawg.io/apidocs
RAWG_API_KEY=

# Any long random string is fine for local/dev use
JWT_SECRET=change-this-dev-only-secret-change-this-dev-only-secret
JWT_EXPIRATION_MINUTES=10080
